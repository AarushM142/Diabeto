# ==============================================================================
# Diabeto Platform — Environment Configuration Template
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
DEBUG=True

# 1. Database & Auth (Supabase PostgreSQL)
# Format: postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
JWT_SECRET=super-secret-dev-jwt-key-change-in-production

# 2. Voice & Speech-to-Text (Sarvam AI)
SARVAM_API_KEY=YOUR_SARVAM_AI_API_KEY

# 3. Generative AI Inference (Groq Cloud & Google Gemini)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# 4. WhatsApp Messaging Channel (Twilio / Meta WhatsApp Business API)
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Optional: Meta WhatsApp Cloud API Direct (if not using Twilio)
META_WA_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
META_WA_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN
META_WA_VERIFY_TOKEN=diabeto_webhook_verify_token_123

# 5. Observability (Sentry)
SENTRY_DSN=
