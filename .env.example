# Diabeto Care Platform — Environment Configuration Template
# Copy this file to .env and fill in your private API credentials.
# NEVER commit the actual .env file with real secrets to version control.

ENVIRONMENT=development
PORT=8000
DEBUG=True

# 1. Database & Auth (Supabase PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diabeto
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
JWT_SECRET=your-secure-jwt-secret-key-min-32-chars

# 2. Voice & Speech-to-Text (Sarvam AI)
SARVAM_API_KEY=your-sarvam-api-key

# 3. Generative AI Inference (Google Gemini Multimodal Vision & Groq Cloud)
GEMINI_API_KEY=your-google-gemini-api-key
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key
GROQ_API_KEY=your-groq-cloud-api-key

# 4. WhatsApp Messaging Channel (Twilio / Meta WhatsApp Business API)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Webhooks without a valid X-Twilio-Signature are rejected when an auth token is set.
# Set to false ONLY for local testing with unsigned requests (WhatsApp simulator, Postman).
TWILIO_VALIDATE_SIGNATURE=true
# Public URL Twilio calls (e.g. your ngrok URL), used for signature checks and status callbacks.
PUBLIC_BASE_URL=
# Demo only: treat unknown numbers as the demo patient. Keep false for any real patients.
ALLOW_DEMO_UNKNOWN_SENDER_FALLBACK=false

META_WA_PHONE_NUMBER_ID=your-meta-wa-phone-number-id
META_WA_ACCESS_TOKEN=your-meta-wa-access-token
META_WA_VERIFY_TOKEN=diabeto_webhook_verify_token

# 5. Observability
SENTRY_DSN=
