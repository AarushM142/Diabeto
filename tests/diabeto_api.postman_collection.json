{
  "info": {
    "name": "Diabeto API Test Suite",
    "_postman_id": "diabeto-api-collection-v1",
    "description": "API collection for testing Diabeto FastAPI backend endpoints (Health, WhatsApp Webhooks, Patient Ingestion, Events, Trends, and Coach Approvals).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "patient_id",
      "value": "replace_after_create_patient",
      "type": "string"
    },
    {
      "key": "recommendation_id",
      "value": "replace_after_get_approvals",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/health",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "Verify API service health and current environment."
      }
    },
    {
      "name": "2. WhatsApp Inbound Webhook",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"919800000001\",\n              \"phone_number_id\": \"123456\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Ramesh Kulkarni\"\n                },\n                \"wa_id\": \"919800000001\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"919800000001\",\n                \"id\": \"wamid.HBgLMTEyMjMzNDQ1NQ==\",\n                \"timestamp\": \"1728400000\",\n                \"text\": {\n                  \"body\": \"Fasting sugar 135\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/webhooks/whatsapp",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "webhooks",
            "whatsapp"
          ]
        },
        "description": "Simulates an inbound WhatsApp text webhook containing glucose reading."
      }
    },
    {
      "name": "3. Create Patient",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clinic_id\": \"clinic_pune_central\",\n  \"clinician_of_record_id\": \"usr_dev_clinician_01\",\n  \"name\": \"Ramesh Kulkarni\",\n  \"age\": 67,\n  \"gender\": \"male\",\n  \"phone\": \"+919800000001\",\n  \"language\": \"mr\",\n  \"consent_flags\": {\n    \"whatsapp\": true,\n    \"voice\": true,\n    \"caregiver_alerts\": true\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/patients",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "patients"
          ]
        },
        "description": "Registers a new elderly patient with demographic, clinical, and consent details."
      }
    },
    {
      "name": "4. Log Normal Glucose Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"glucose\",\n  \"value\": {\n    \"mgdl\": 125,\n    \"context\": \"fasting\"\n  },\n  \"measured_at\": \"2026-10-08T08:00:00Z\",\n  \"reported_by\": \"patient\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/patients/{{patient_id}}/events",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "patients",
            "{{patient_id}}",
            "events"
          ]
        },
        "description": "Logs an in-range glucose event (125 mg/dL) that evaluates to risk_status = normal."
      }
    },
    {
      "name": "5. Log High-Risk Glucose Event",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"glucose\",\n  \"value\": {\n    \"mgdl\": 290,\n    \"context\": \"post_dinner\"\n  },\n  \"measured_at\": \"2026-10-08T21:00:00Z\",\n  \"reported_by\": \"patient\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/patients/{{patient_id}}/events",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "patients",
            "{{patient_id}}",
            "events"
          ]
        },
        "description": "Logs a high glucose reading (290 mg/dL) triggering safety rules."
      }
    },
    {
      "name": "6. Get Patient Trends",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/patients/{{patient_id}}/trends?days=14",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "patients",
            "{{patient_id}}",
            "trends"
          ],
          "query": [
            {
              "key": "days",
              "value": "14"
            }
          ]
        },
        "description": "Fetches rolling glucose readings and aggregate trend metrics for the patient."
      }
    },
    {
      "name": "7. Get Pending Approvals",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/v1/approvals",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "approvals"
          ]
        },
        "description": "Lists all lifestyle recommendations pending review by the coach."
      }
    },
    {
      "name": "8. Post Approval Decision",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"decision\": \"approved\",\n  \"feedback\": \"Verified by coach\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/v1/approvals/{{recommendation_id}}/decision",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "v1",
            "approvals",
            "{{recommendation_id}}",
            "decision"
          ]
        },
        "description": "Records the coach's approval decision for a pending recommendation."
      }
    }
  ]
}
